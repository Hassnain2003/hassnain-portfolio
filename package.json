    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.29",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4",
